{
    "regions": ["bom1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        { "src": "/", "dest": "/api/index.php?route=index.php" },
        { "src": "/admin/?", "dest": "/api/index.php?route=admin/index.php" },
        { "src": "/(.*\\.php)", "dest": "/api/index.php?route=$1" },
        { "handle": "filesystem" }
    ]
}
